FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
COPY frontend/package.json frontend/
COPY gateway/package.json gateway/
RUN npm ci
COPY gateway gateway
COPY infra/migrations infra/migrations
COPY infra/azure/gateway-entrypoint.sh /app/gateway/entrypoint.sh
RUN npm run build -w gateway && chmod +x /app/gateway/entrypoint.sh
WORKDIR /app/gateway
ENV NODE_ENV=production
EXPOSE 4100
CMD ["./entrypoint.sh"]
