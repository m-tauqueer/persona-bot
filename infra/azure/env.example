# Copy to `infra/azure/env` (gitignored). Names and the public origin only.
# App secrets stay in the repo-root `.env`. Never commit either file.

AZURE_LOCATION=centralus
AZURE_RESOURCE_GROUP=cognora-alpha-rg
PUBLIC_ORIGIN=https://bot.metacog.in

AZURE_CONTAINER_ENV=cae-bot-metacog
AZURE_APP_WEB=bot-web
AZURE_APP_GATEWAY=bot-gateway
AZURE_APP_WORKER=bot-worker
AZURE_LOG_WORKSPACE=law-bot-metacog
AZURE_POSTGRES_ADMIN=voicebot
AZURE_POSTGRES_DB=voicebot
AZURE_POSTGRES_EXTENSIONS=pgcrypto
AZURE_REDIS_SKU=Balanced_B0
AZURE_REDIS_PORT=10000
AZURE_REDIS_PUBLIC_ACCESS=Enabled
# Globally unique names are written to infra/azure/.state on first create.
# AZURE_ACR_NAME=
# AZURE_POSTGRES_NAME=
# AZURE_REDIS_NAME=
