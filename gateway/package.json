{
  "name": "gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web, auth, and WebSocket bridge to Deepgram",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "migrate": "tsx src/migrate-cli.ts",
    "retain": "tsx src/lifecycle/retain-cli.ts",
    "smoke": "tsx src/smoke.ts",
    "voice": "tsx src/voice/probe.ts",
    "audio": "tsx src/voice/audioProbe.ts",
    "bargein": "tsx src/voice/bargeInProbe.ts",
    "call": "tsx src/voice/callProbe.ts",
    "fish": "tsx src/fish/probe.ts",
    "isolation": "tsx src/voice/isolationProbe.ts",
    "failures": "tsx src/voice/failureProbe.ts",
    "budgets": "tsx src/observe/budgetProbe.ts",
    "observe": "tsx src/observe/opsProbe.ts",
    "security": "tsx src/observe/securityProbe.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.32.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.2.0",
    "@msgpack/msgpack": "^3.1.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.10",
    "pino": "^10.3.1",
    "postgres": "^3.4.7",
    "ws": "^8.21.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
