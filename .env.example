# Space- or comma-separated Google emails allowed to use /admin.
# OWNER_EMAILS=you@example.com

# --- Engram (optional until the brain) ---
# A throwaway persona (local personas.id); never a persona members can reach.
# Write-capable probes skip cleanly when this is unset.
# PROBE_PERSONA_ID=
# ENGRAM_API_KEY=
# ENGRAM_ORG_ID=
# ENGRAM_BASE_URL=https://api-engram-alpha.getmetacognition.com
# ENGRAM_TIMEOUT_SECONDS=120
# ENGRAM_MESSAGE_JOIN= 
# ENGRAM_READ_MAX_RETRIES=2
# Open Engram clients kept warm, one per user. Saves a TLS handshake per turn.
# ENGRAM_CLIENT_CACHE_SIZE=8
# Which brain answers a turn. "retrieve" (default) reads memory and composes
# the reply here. Sitting transcript stays in Postgres; Engram private is
# not converse-written (private writes wait for caller-fact extract).
# "chat" asks Engram to compose it instead and writes the caller's private
# pool; it cannot boot while ENGRAM_MEMBER_SESSION_AUTH is false.
# BRAIN_MODE=retrieve
# Per-member Engram session tokens. Leave false. Do not set true until the
# worker stores each member's Engram password and talks as that member —
# turning this on without that work does not isolate memory. Containment
# (no write into the API key owner's pool, no BRAIN_MODE=chat) holds while
# this is false and is not an off switch for the retrieve tenant filter.
# ENGRAM_MEMBER_SESSION_AUTH=false
# 32 random bytes, base64. Encrypts each member's Engram password at rest.
# Required when ENGRAM_MEMBER_SESSION_AUTH=true. Rotating this re-encrypts
# stored ciphertext; it must never be used to derive a password. Empty is unset.
# ENGRAM_MEMBER_SECRET_KEY=
# Refresh a member session token this many seconds before it expires.
# ENGRAM_MEMBER_TOKEN_REFRESH_SKEW_SECONDS=1800
# ENGRAM_RETRIEVE_TOP_K=25
# Path prefix for the Engram API. The SDK discovers this from /config; our own
# scoped calls need it explicitly. Live alpha reports "v1".
# ENGRAM_API_VERSION_PATH=/v1
# Wire values for the retrieve scope parameter. Unknown values are a 422 at
# Engram, which is the behaviour we want — a typo must fail loudly, not fall
# back to shared-only.
# ENGRAM_RETRIEVE_SCOPE_SHARED=shared
# ENGRAM_RETRIEVE_SCOPE_PRIVATE=private
# ENGRAM_RETRIEVE_SCOPE_BOTH=both
# Per-pool retrieval budgets. Two scoped calls replace one merged call, so
# these are set independently rather than splitting one top_k. ENGRAM_RETRIEVE_TOP_K
# (25) stays for the merged/fallback path.
# ENGRAM_RETRIEVE_TOP_K_SHARED=25
# ENGRAM_RETRIEVE_TOP_K_PRIVATE=25
# Pool label stored on each memory_refs row so a trace can tell which list
# a hit came from. Distinct from tenant parsing.
# MEMORY_REF_POOL_KEY=pool
# MEMORY_REF_POOL_PERSONA=persona
# MEMORY_REF_POOL_CALLER=caller
# ENGRAM_CONVERSE_WRITEBACK=true
# Off-path write worker. When true, an authenticated retrieve turn extracts
# caller facts after the reply and writes them as private text on the member
# JWT. It does not converse the sitting. Degraded / unauthenticated members
# never write. Timeout, error, or unrecognised JSON writes nothing extra.
# ENGRAM_WRITEBACK_REASON_PAUSED=private_write_paused
# ENGRAM_WRITEBACK_REASON_UNAUTHENTICATED=unauthenticated
# ENGRAM_WRITEBACK_REASON_CLAIM_FAILED=claim_failed
# ENGRAM_WRITEBACK_REASON_WRITE_FAILED=write_failed
# LOG_ENGRAM_WRITEBACK=engram_writeback
# Empty model uses OPENAI_MODEL. Structured JSON; empty caller_facts is success.
# CALLER_FACT_MODEL=
# CALLER_FACT_TIMEOUT_SECONDS=15
# CALLER_FACT_TEMPERATURE=0
# CALLER_FACT_MAX_TOKENS=256
# CALLER_FACT_MAX_FACTS=8
# Per-turn brief: extract the newest exchange only; history is context that
# earlier passes already recorded.
# CALLER_FACT_SYSTEM_PROMPT=
# Hang-up brief: only what needed the whole sitting to see. Empty is usual.
# CALLER_FACT_CLOSING_SYSTEM_PROMPT=
# Third-person framing. A fact without this prefix is discarded before it
# can reach the private pool, where it would read as persona speech.
# CALLER_FACT_PREFIX=The caller
# Private rows are append-only, so a correction never removes the stale row.
# The date rides in the row and lets the answerer prefer the newer of two
# conflicting caller memories. Template must contain {date}.
# CALLER_FACT_STAMP_ENABLED=true
# CALLER_FACT_STAMP_TEMPLATE= (stated {date})
# CALLER_FACT_STAMP_DATE_FORMAT=%Y-%m-%d
# CALLER_FACT_PAYLOAD_HISTORY_KEY=history
# CALLER_FACT_PAYLOAD_USER_TURN_KEY=user_turn
# CALLER_FACT_PAYLOAD_PERSONA_REPLY_KEY=persona_reply
# CALLER_FACT_PAYLOAD_FACTS_KEY=caller_facts
# CALLER_FACT_PAYLOAD_SPEAKER_KEY=speaker
# CALLER_FACT_PAYLOAD_TEXT_KEY=text
# CALLER_FACT_RESPONSE_FORMAT_TYPE=json_object
# CALLER_FACT_REASON_EMPTY=empty
# CALLER_FACT_REASON_EXTRACTED=extracted
# CALLER_FACT_REASON_TIMEOUT=timeout
# CALLER_FACT_REASON_ERROR=error
# CALLER_FACT_REASON_UNRECOGNISED=unrecognised
# Hang-up safety net over the full sitting. Same extractor, closing brief.
# Size is a write budget, not language understanding. One extra extract
# attempt on worker fault.
# CALLER_FACT_CLOSING_MAX_TURNS=200
# CALLER_FACT_CLOSING_MAX_BYTES=48000
# CALLER_FACT_CLOSING_RETRIES=1
# INTERNAL_CLOSING_PATH=/internal/closing-pass
# LOG_ENGRAM_CLOSING=engram_closing
# CALLER_FACT_CLOSING_REASON_MISSING=missing
# CALLER_FACT_CLOSING_REASON_NOT_ENDED=not_ended
# CALLER_FACT_CLOSING_REASON_ALREADY=already
# ENGRAM_CONVERSE_USER_SPEAKER=user
# ENGRAM_CONVERSE_PERSONA_SPEAKER=persona
# ENGRAM_WRITEBACK_WORKERS=2
# Retrieval pool. Separate from the write-back pool because reads sit on the
# path to first word: sharing one would put a private write in front of
# the next turn's retrieve. One private read is submitted per turn; the shared
# read runs on the calling thread.
# ENGRAM_RETRIEVE_WORKERS=4
# Scope classifier. Issued beside the two retrieves, never in front of
# them. Timeout, error, or an unrecognised value falls open to both
# pools. The decision may only drop a labelled list; it never adds one
# and never bypasses may_ground. Off until you turn it on for a sitting.
# ENGRAM_SCOPE_ROUTER_ENABLED=false
# Empty model uses OPENAI_MODEL.
# ENGRAM_SCOPE_ROUTER_MODEL=
# Must finish inside the retrieve window. Overrun past Engram is the
# only added latency, and it lands before the first spoken word, so keep
# it short. Timeout falls open to both labelled lists.
# ENGRAM_SCOPE_ROUTER_TIMEOUT_SECONDS=1.5
# ENGRAM_SCOPE_ROUTER_SYSTEM_PROMPT=
# Own pool so the classifier never shares ENGRAM_RETRIEVE_WORKERS or
# ENGRAM_WRITEBACK_WORKERS.
# ENGRAM_SCOPE_ROUTER_WORKERS=4
# ENGRAM_SCOPE_ROUTER_TEMPERATURE=0
# ENGRAM_SCOPE_ROUTER_MAX_TOKENS=64
# JSON keys the classifier reads. Wire scope values are the retrieve
# scopes above. Reason codes are closed; an unknown value falls open.
# ENGRAM_SCOPE_ROUTER_SCOPE_KEY=scope
# ENGRAM_SCOPE_ROUTER_REASON_KEY=reason
# ENGRAM_SCOPE_ROUTER_QUESTION_KEY=question
# ENGRAM_SCOPE_ROUTER_RESPONSE_FORMAT_TYPE=json_object
# ENGRAM_SCOPE_ROUTER_REASON_SHARED=persona_directed
# ENGRAM_SCOPE_ROUTER_REASON_PRIVATE=self_directed
# ENGRAM_SCOPE_ROUTER_REASON_BOTH=ambiguous
# ENGRAM_SCOPE_ROUTER_REASON_TIMEOUT=timeout
# ENGRAM_SCOPE_ROUTER_REASON_ERROR=error
# ENGRAM_SCOPE_ROUTER_REASON_UNRECOGNISED=unrecognised
# ENGRAM_SCOPE_ROUTER_REASON_DISABLED=disabled
# ENGRAM_SCOPE_ROUTER_REASON_UNAUTHENTICATED=unauthenticated
# Optional seed when the local personas table is empty. Never the active-persona resolver.
# ENGRAM_PERSONA_ID=
# Query/body field that pins a sitting to a local persona UUID (chat, voice, memory).
# PERSONA_ID_QUERY=persona_id
# Key inside personas.voice_config for the Deepgram TTS voice id.
# PERSONA_VOICE_TTS_KEY=tts_voice
# Key inside personas.voice_config for a hosted Fish Audio voice id. Must differ
# from PERSONA_VOICE_TTS_KEY. Presence of an id does not choose the sitting;
# PERSONA_VOICE_PROVIDER_KEY does.
# PERSONA_VOICE_FISH_KEY=fish_voice
# Dedicated key for the owner's Aura vs Fish choice. Values come from
# PERSONA_VOICE_PROVIDER_AURA / PERSONA_VOICE_PROVIDER_FISH. Empty means Aura.
# PERSONA_VOICE_PROVIDER_KEY=voice_provider
# PERSONA_VOICE_PROVIDER_AURA=aura
# PERSONA_VOICE_PROVIDER_FISH=fish
# Hosted Fish API. Optional at boot. Required to clone or speak a Fish id.
# FISH_API_KEY=
# FISH_API_BASE_URL=https://api.fish.audio
# FISH_TTS_MODEL=s2.1-pro-free
# FISH_TTS_FORMAT=pcm
# Must match the browser playback rate (VITE_DEEPGRAM_AUDIO_OUTPUT_SAMPLE_RATE).
# FISH_TTS_SAMPLE_RATE=24000
# FISH_TTS_LATENCY=balanced
# FISH_TTS_LIVE_PATH=/v1/tts/live
# FISH_TTS_TIMEOUT_MS=60000
# FISH_PROBE_TEXT=Hello from the live voice check.
# FISH_PROBE_REFERENCE_ID=
# DEEPGRAM_LISTEN_WSS_URL=wss://api.deepgram.com/v1/listen
# Silence Listen VAD needs before speech_final. UtteranceEnd is the fallback
# that carries an echoey room (the persona leaking into the mic means VAD may
# never see silence), so this can stay short.
# DEEPGRAM_LISTEN_ENDPOINTING_MS=600
# Word-timing gap before Listen reports UtteranceEnd. Deepgram's minimum is 1000.
# DEEPGRAM_LISTEN_UTTERANCE_END_MS=1000
# How long you must keep producing words, while the persona is still speaking,
# before the persona stops talking. Not a VAD click and not the first word:
# sustained speech. The reply still waits for the utterance to finish. Raise this
# if the persona interrupts itself on speakers (its own voice reaching the mic).
# VOICE_BARGE_IN_HOLD_MS=500
# DEEPGRAM_LISTEN_INTERIM_RESULTS=true
# DEEPGRAM_LISTEN_VAD_EVENTS=true
# FISH_CLONE_TYPE=tts
# FISH_CLONE_TRAIN_MODE=fast
# FISH_CLONE_VISIBILITY=private
# FISH_CLONE_ENHANCE=true
# FISH_CLONE_READY_STATE=trained
# FISH_CLONE_TIMEOUT_SECONDS=60
# FISH_CLONE_CONTENT_TYPES=audio/wav,audio/mpeg,audio/mp4,audio/ogg,audio/webm,audio/x-wav
# FISH_CLONE_SUFFIXES=.wav,.mp3,.m4a,.opus,.webm,.ogg
# ADMIN_ERROR_FISH_KEY_MISSING=Fish API key is not set
# ADMIN_ERROR_FISH_UNAUTHORIZED=Fish rejected the API key
# ADMIN_ERROR_FISH_PAYMENT=Fish has no remaining API credits
# ADMIN_ERROR_FISH_CLONE_FAILED=Fish could not clone that clip
# ADMIN_ERROR_FISH_UNTRAINED=Fish has not finished training that voice
# ADMIN_ERROR_FISH_CLIP_TYPE=clip type is not allowed
# ADMIN_ERROR_FISH_CLIP_EMPTY=clip is empty
# ADMIN_ERROR_PERSONA_PIN_REQUIRED=persona_id is required when several personas exist
# ADMIN_ERROR_CREATE_FORBIDDEN=Engram refused create; record a dashboard persona id instead
# ADMIN_ERROR_DESTROY_CONFIRMATION=type the persona handle exactly to destroy it
# ADMIN_ERROR_FORGET_PRIVATE_CONFIRMATION=type the persona handle exactly to forget that private pool
# ADMIN_ERROR_USER_MISSING=no signed-in user matches that identifier
# ADMIN_ERROR_ENGRAM_USER_MISSING=that member has no Engram user id
# Missing or unpublished persona uses the same 404 copy as a missing session.
# INSIGHTS_ERROR_NOT_FOUND=session not found

# --- Reframe LLM (optional until the brain) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
# OPENAI_API_BASE_URL=https://api.openai.com
# REFRAME_HISTORY_TURNS=24
# REFRAME_TEMPERATURE=0.2
# REFRAME_MAX_TOKENS=256
# REFRAME_TIMEOUT_SECONDS=30
# Stream the reframe so the voice transport speaks on the first token.
# REFRAME_STREAM_ENABLED=true
# REFRAME_SYSTEM_PROMPT=
# Used only when BRAIN_MODE=retrieve. Key names must match the system prompt.
# ANSWER_SYSTEM_PROMPT=
# ANSWER_TEMPERATURE=0
# ANSWER_MAX_TOKENS=320
# ANSWER_PAYLOAD_PERSONA_MEMORIES_KEY=persona_memories
# ANSWER_PAYLOAD_CALLER_MEMORIES_KEY=caller_memories
# Who the persona is, from the local catalog row (display_name, description).
# Engram grounds a chat-mode reply on these already; the retrieve path composes
# the reply here, so without them a persona cannot answer "what is your name?"
# from anything but a memory that happens to state it in the first person.
# ANSWER_PAYLOAD_PERSONA_IDENTITY_KEY=persona_identity
# PERSONA_IDENTITY_NAME_KEY=name
# PERSONA_IDENTITY_DESCRIPTION_KEY=description
# ANSWER_PAYLOAD_HISTORY_KEY=history
# ANSWER_PAYLOAD_QUESTION_KEY=question
# ANSWER_PAYLOAD_VOICE_CONFIG_KEY=voice_config

# --- Worker Postgres pool (connections are reused across turns) ---
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=8
# DB_POOL_TIMEOUT_SECONDS=10
# DB_POOL_MAX_IDLE_SECONDS=300
