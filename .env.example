# --- Postgres / Redis (Compose). DATABASE_URL / REDIS_URL must match host ports. ---
# If 5432 or 6379 is already in use on the machine, change POSTGRES_PORT / REDIS_PORT and the URLs together.
POSTGRES_USER=voicebot
POSTGRES_PASSWORD=voicebot
POSTGRES_DB=voicebot
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://voicebot:voicebot@localhost:5432/voicebot
REDIS_URL=redis://localhost:6379

# --- Session (min 16 characters) ---
SESSION_SECRET=replace-with-at-least-16-chars
# Shared secret for gateway ↔ worker. Dedicated; do not reuse SESSION_SECRET.
INTERNAL_API_SECRET=replace-with-a-long-random-secret
# Brute-force throttle on the worker's internal-secret guard. Only failed
# authentications are counted, keyed by client address (Redis-backed, fails open).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REDIS_PREFIX=ratelimit:
# RATE_LIMIT_USER_KEY_PREFIX=user:
# RATE_LIMIT_IP_KEY_PREFIX=ip:
