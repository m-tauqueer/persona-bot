# Copy to `.env` in this directory. Never commit `.env`.
# Gateway and worker load this file. Vite (frontend) reads it too; only VITE_* reach the browser.
#
# Required to boot gateway now: local URLs/secrets below + Google Sign-In.
# Optional until later parts: Azure, Deepgram, Engram, OpenAI, BYO_LLM_PUBLIC_URL.
# Unit-test coverage floors live in config/test-coverage.json (npm test / npm run test:worker).

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- Public URLs / bind ---
GATEWAY_HOST=0.0.0.0
# Bind port for the gateway process. Do not use 4000 if Engram's API is already there.
GATEWAY_PORT=4100
# Browser-facing origin. Vite proxies /auth /api /ws to GATEWAY_PORT.
# Production uses one public origin (see infra/azure/env.example). The deploy
# script retargets these URLs; do not point this file at that host for local work.
GATEWAY_PUBLIC_URL=http://localhost:5188
FRONTEND_ORIGIN=http://localhost:5188
CORS_ALLOWED_METHODS=GET,HEAD,POST,PUT,PATCH,DELETE
# Per-request rate limit on the gateway (Redis-backed, fails open on a Redis error).
# Member cookies key by user id; everyone else keys by IP.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_REDIS_PREFIX=ratelimit:
# RATE_LIMIT_USER_KEY_PREFIX=user:
# RATE_LIMIT_IP_KEY_PREFIX=ip:
# Daily spend caps. 0 disables that cap. Off until named back on.
QUOTA_TURNS_PER_DAY=0
QUOTA_VOICE_MINUTES_PER_DAY=0
# QUOTA_TIMEZONE=UTC
# QUOTA_WARN_RATIO=0.8
WORKER_HOST=0.0.0.0
WORKER_PORT=8000
WORKER_URL=http://localhost:8000
# OpenAPI UI on the worker. Off: the think endpoint is publicly reachable.
# WORKER_OPENAPI_ENABLED=false
# Public URL Deepgram will call for BYO-LLM (dev: tunnel to the worker, not the gateway; Azure: public worker URL)
# Example local tunnel: ngrok http 8000   then set this to the https origin ngrok prints.
# BYO_LLM_PUBLIC_URL=
# Optional extra think-endpoint headers (JSON object). Needed for some tunnels:
# BYO_LLM_ENDPOINT_EXTRA_HEADERS={"ngrok-skip-browser-warning":"true"}

# --- Frontend (browser-safe; Vite exposes only VITE_*) ---
VITE_GATEWAY_URL=http://localhost:5188
VITE_CHAT_SESSION_STORAGE_KEY=vb-chat-session
VITE_VOICE_WS_PATH=/ws/voice
VITE_PERSONA_ID_QUERY=persona_id
